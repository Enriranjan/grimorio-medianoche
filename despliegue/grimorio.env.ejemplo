# /etc/grimorio.env  (root:root, permisos 600)
# PIN del director: 4 a 64 caracteres sin espacios. Tras cambiarlo: sudo systemctl restart grimorio
GRIMORIO_PIN=cambia-esto
# Puerto local (Caddy hace de proxy desde :80 /grimorio/)
PORT=8002
# Dirección que llevará el QR de la mesa. Vacía = la misma desde la que abres /director.
URL_JUGADORES=http://192.168.1.2/grimorio/jugar
# IPs desde las que llega cloudflared (solo de ahí se cree CF-Connecting-IP). Por defecto, la propia Pi.
#IPS_TUNEL=127.0.0.1,::1
#LOG_LEVEL=info
